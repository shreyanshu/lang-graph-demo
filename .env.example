# ---------------------------------------------------------------------------
# Copy this file to `.env` and paste your real key there.
# `.env` is git-ignored, so the key never ends up in version control.
# ---------------------------------------------------------------------------

# Google AI Studio key: https://aistudio.google.com/apikey
# Either name works; GOOGLE_API_KEY is the one the Google SDKs read by default.
GOOGLE_API_KEY=paste-your-key-here
# GEMINI_API_KEY=paste-your-key-here

# Model used by the planner / executor / replanner.
# Fast + cheap:        gemini-2.5-flash
# Stronger reasoning:  gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# 0.0 = deterministic plans, 1.0 = very creative.
GEMINI_TEMPERATURE=0.0

# Safety rails for the planner/executor loop.
MAX_STEPS=8
MAX_REVISIONS=2
RECURSION_LIMIT=60

# Optional: LangSmith tracing (leave commented out unless you want traces)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=langgraph-planner-executor
